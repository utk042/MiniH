# ---------------------------------------------------------------------------
# BACKSTACK — environment
# Copy to .env.local (Next.js) and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Supabase: client-visible -----------------------------------------------
# Safe to ship to the browser. The anon key is gated by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase: server only --------------------------------------------------
# Direct Postgres connection, used by scripts only (migrations, seeding,
# verify) — never by the app. The app itself holds no service-role or
# elevated key anywhere: every request runs under the signed-in student's own
# session, scoped by RLS. Supabase dashboard -> Project Settings -> Database.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# --- Gemini: server only ----------------------------------------------------
# Used by the canonicalization + tagging pipeline. Server only, read in
# exactly one place (lib/ai/gemini.ts). Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key

# --- Site ---------------------------------------------------------------
# Used to build the magic-link redirect URL. http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Campus -----------------------------------------------------------------
# The single email domain allowed to sign up. This value is ALSO stored in the
# database (public.app_config, key 'allowed_email_domain') where a trigger on
# auth.users enforces it. Change it in both places, or run:
#   select public.set_allowed_email_domain('yourcampus.edu');
NEXT_PUBLIC_CAMPUS_EMAIL_DOMAIN=westfield.edu

# Shown in UI chrome. Cosmetic only.
NEXT_PUBLIC_CAMPUS_NAME=Westfield College

# --- Storage ----------------------------------------------------------------
# Bucket for copy photos. Created by migration 20260814000600.
NEXT_PUBLIC_SUPABASE_COPY_PHOTO_BUCKET=copy-photos
